#!/bin/sh
# Direct execution must use a controller runtime that can verify signed Herdr
# evidence.  install.sh provisions the preferred private environment; the host
# interpreter is only a compatibility fallback for an existing checkout.
set -eu
umask 077
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname -- "$script")/$target ;;
  esac
done
repo=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd -P)

runtime=
for candidate in "$repo/.venv/bin/python" "${HELM_PYTHON:-}" python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
  [ -n "$candidate" ] || continue
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import sys; from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
    runtime=$candidate
    break
  fi
done
if [ -z "$runtime" ]; then
  printf '%s\n' 'helm: no Python 3.10+ runtime with cryptographic receipt verification; run firstmate-graph/install.sh' >&2
  exit 126
fi
PYTHONPATH=$repo
export PYTHONPATH
exec "$runtime" -m helm "$@"
