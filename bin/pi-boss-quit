#!/usr/bin/env bash
# Stop the BOSS workers and close its persistent Herdr session.
#
#   pi-boss-quit           stop and exit
#   pi-boss-quit --restart stop, then reopen via `pi-boss` so the new masthead lands
#   pi-boss-quit --yes     stop even if work is active (default refuses if work is active)
set -euo pipefail

FORCE=0
RESTART=0
for arg in "$@"; do
  case "$arg" in
    --force|--yes|-y) FORCE=1 ;;
    --restart|-r)     RESTART=1 ;;
    --help|-h)
      awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 0
      ;;
    *)
      printf 'pi-boss-quit: unknown arg %s\n' "$arg" >&2; exit 2 ;;
  esac
done

bindir="$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")"

# Refuse to interrupt in-flight work unless the user explicitly opted in. The guard
# fails closed: if the controller cannot list work, or the list cannot be parsed, we
# do not know that nothing is running, so we refuse rather than tear down blind.
# `bossctl work --all --json` prints a raw JSON array, not an {"items": [...]} envelope.
if [ "$FORCE" -eq 0 ]; then
  if ! items="$("$bindir/bossctl" work --all --json)"; then
    printf 'pi-boss-quit: could not verify in-flight work (bossctl failed); run pi-boss doctor, or re-run with --yes\n' >&2
    exit 1
  fi
  # 0 = no active work, 1 = active work, 2 = unparseable (treated as active).
  verdict=0
  printf '%s' "$items" | python3 -c 'import json,sys
try:
    items = json.loads(sys.stdin.read())
    active = [i for i in items if i.get("status") in {"running", "ready", "pr-open"}]
except Exception:
    raise SystemExit(2)
raise SystemExit(1 if active else 0)' || verdict=$?
  case "$verdict" in
    0) ;;
    1) printf 'pi-boss-quit: in-flight work is active. Re-run with --yes to stop anyway.\n' >&2; exit 1 ;;
    *) printf 'pi-boss-quit: could not parse the work list; refusing to stop blind (re-run with --yes)\n' >&2; exit 1 ;;
  esac
fi

if ! "$bindir/bossctl" down --json >/dev/null; then
  printf 'pi-boss-quit: worker shutdown was not positively verified; run pi-boss doctor\n' >&2
  exit 1
fi

herdr_bin="${HERDR_BIN:-$(command -v herdr 2>/dev/null || true)}"
if [ -z "$herdr_bin" ]; then
  printf 'pi-boss-quit: herdr is not installed\n' >&2
  exit 1
fi

if ! "$herdr_bin" session stop boss --json >/dev/null; then
  printf 'pi-boss-quit: Herdr refused to stop the boss session\n' >&2
  exit 1
fi
sessions="$($herdr_bin session list --json)" || {
  printf 'pi-boss-quit: could not verify Herdr session state\n' >&2
  exit 1
}
if ! python3 -c 'import json,sys
data=json.loads(sys.argv[1]); matches=[x for x in data.get("sessions",[]) if x.get("name")=="boss"]
raise SystemExit(0 if matches and matches[0].get("running") is False else 1)' "$sessions"; then
  printf 'pi-boss-quit: boss session did not prove it stopped\n' >&2
  exit 1
fi
printf 'BOSS closed\n'

if [ "$RESTART" -eq 1 ]; then
  exec "$bindir/pi-boss"
fi
