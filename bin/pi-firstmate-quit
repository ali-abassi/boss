#!/usr/bin/env bash
# Stop the First Mate workers and close its persistent Herdr session.
set -euo pipefail

bindir="$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")"
if ! "$bindir/helm" down --json >/dev/null; then
  printf 'pi-firstmate-quit: worker shutdown was not positively verified; run pi-firstmate doctor\n' >&2
  exit 1
fi

herdr_bin="${HERDR_BIN:-$(command -v herdr 2>/dev/null || true)}"
if [ -z "$herdr_bin" ]; then
  printf 'pi-firstmate-quit: herdr is not installed\n' >&2
  exit 1
fi

if ! "$herdr_bin" session stop firstmate --json >/dev/null; then
  printf 'pi-firstmate-quit: Herdr refused to stop the firstmate session\n' >&2
  exit 1
fi
sessions="$($herdr_bin session list --json)" || {
  printf 'pi-firstmate-quit: could not verify Herdr session state\n' >&2
  exit 1
}
if ! python3 -c 'import json,sys
data=json.loads(sys.argv[1]); matches=[x for x in data.get("sessions",[]) if x.get("name")=="firstmate"]
raise SystemExit(0 if matches and matches[0].get("running") is False else 1)' "$sessions"; then
  printf 'pi-firstmate-quit: firstmate session did not prove it stopped\n' >&2
  exit 1
fi
printf 'first mate closed\n'
